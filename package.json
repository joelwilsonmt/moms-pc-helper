{
  "name": "moms-pc-helper",
  "version": "1.0.6",
  "description": "Mom's PC Helper — read-only PC health monitor for Jan",
  "author": "Joel Wilson <joel.wilson.mt@gmail.com>",
  "main": "./out/main/index.js",
  "homepage": "./",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:win": "npm run build && electron-builder --win",
    "preview": "electron-vite preview",
    "test": "vitest run"
  },
  "build": {
    "appId": "com.joelwilson.moms-pc-helper",
    "productName": "Mom's PC Helper",
    "copyright": "Copyright © 2025 Joel Wilson",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      { "from": "resources/helpers",    "to": "helpers" },
      { "from": "resources/guides",     "to": "guides" },
      { "from": "resources/checklists", "to": "checklists" }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mom's PC Helper",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "license": "LICENSE.txt"
    },
    "publish": null
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.26.0",
    "@electron-toolkit/utils": "^4.0.0",
    "dompurify": "^3.1.5",
    "electron-log": "^5.1.7",
    "electron-store": "^10.0.0",
    "marked": "^12.0.0",
    "nodemailer": "^6.9.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.4"
  },
  "optionalDependencies": {
    "better-sqlite3-multiple-ciphers": "^11.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^2.0.0",
    "@electron-toolkit/eslint-config-ts": "^2.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/better-sqlite3": "^7.6.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20.14.9",
    "@types/nodemailer": "^6.4.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.1.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vitest": "^2.0.3"
  }
}
